# MedicAssist AI Configuration

# LLM Providers (Optional - leave blank to use Deterministic Engine mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///medicassist.db

# OCR Configuration (Optional - path to tesseract binary if not in PATH)
# On macOS: /opt/homebrew/bin/tesseract
TESSERACT_CMD=

# Server & CORS Configuration
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
